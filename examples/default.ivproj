{
    "cycleMs": 1000,
    "database": {
        "database": "data/inspection.sqlite",
        "driver": "QSQLITE",
        "host": "localhost",
        "odbcDriver": "ODBC Driver 18 for SQL Server",
        "passwordEnvironment": "IVS_SQLSERVER_PASSWORD",
        "port": 1433,
        "trustServerCertificate": false,
        "user": ""
    },
    "devices": [
        {
            "backend": "simulated",
            "category": "camera",
            "host": "127.0.0.1",
            "id": "camera-1",
            "model": "模拟相机",
            "parameters": {
            },
            "port": 502,
            "unitId": 1
        },
        {
            "backend": "simulated",
            "category": "motion",
            "host": "127.0.0.1",
            "id": "motion-1",
            "model": "模拟四轴平台",
            "parameters": {
            },
            "port": 502,
            "unitId": 1
        },
        {
            "backend": "simulated",
            "category": "light",
            "host": "127.0.0.1",
            "id": "light-1",
            "model": "模拟四通道光源",
            "parameters": {
            },
            "port": 502,
            "unitId": 1
        },
        {
            "backend": "simulated",
            "category": "plc",
            "host": "127.0.0.1",
            "id": "plc-1",
            "model": "模拟 Modbus PLC",
            "parameters": {
            },
            "port": 502,
            "unitId": 1
        },
        {
            "backend": "simulated",
            "category": "io",
            "host": "127.0.0.1",
            "id": "io-1",
            "model": "模拟数字 I/O",
            "parameters": {
            },
            "port": 502,
            "unitId": 1
        }
    ],
    "flow": [
        {
            "enabled": true,
            "id": "trigger-1",
            "parameters": {
                "timeoutMs": 60000
            },
            "title": "等待触发",
            "type": "trigger"
        },
        {
            "enabled": true,
            "id": "move-1",
            "parameters": {
                "position": 0,
                "axis": 0,
                "speed": 25
            },
            "title": "运动定位",
            "type": "move"
        },
        {
            "enabled": true,
            "id": "light-1",
            "parameters": {
                "brightness": 80,
                "channel": 0,
                "enabled": true
            },
            "title": "光源控制",
            "type": "light"
        },
        {
            "enabled": true,
            "id": "capture-1",
            "parameters": {
            },
            "title": "图像采集",
            "type": "capture"
        },
        {
            "enabled": true,
            "id": "inspect-1",
            "parameters": {
            },
            "title": "图像测量",
            "type": "inspect"
        },
        {
            "enabled": true,
            "id": "judge-1",
            "parameters": {
            },
            "title": "结果判定",
            "type": "judge"
        },
        {
            "enabled": true,
            "id": "store-1",
            "parameters": {
            },
            "title": "保存记录",
            "type": "store"
        },
        {
            "enabled": true,
            "id": "output-1",
            "parameters": {
            },
            "title": "输出结果",
            "type": "output"
        }
    ],
    "imagePolicy": "ng",
    "imageQuotaMB": 1024,
    "imageRetentionDays": 30,
    "maxDiameterMm": 21,
    "minDiameterMm": 19,
    "name": "单工位尺寸检测示范",
    "panels": [
        {
            "field": "diameterMm",
            "id": "image-1",
            "title": "实时检测图像",
            "type": "image"
        },
        {
            "field": "diameterMm",
            "id": "table-1",
            "title": "最近检测记录",
            "type": "table"
        },
        {
            "field": "diameterMm",
            "id": "trend-1",
            "title": "尺寸趋势",
            "type": "trend"
        },
        {
            "field": "offsetYmm",
            "id": "scatter-1",
            "title": "位置分布",
            "type": "scatter"
        },
        {
            "field": "durationMs",
            "id": "log-1",
            "title": "运行事件",
            "type": "log"
        }
    ],
    "pixelsPerMm": 20,
    "recipe": "配方 1.0",
    "resolution": {
        "height": 2048,
        "width": 2448
    },
    "schemaVersion": 1
}
